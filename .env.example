# ==============================================================================
# coolify-bale: Environment Configuration
# ==============================================================================
# Copy this file to .env and customize the values for your deployment.
# NEVER commit your production .env file to version control!
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Request Logging
# Set to 'true' to log incoming requests and response statuses.
# (Headers, Authorization tokens, and request payloads are NEVER logged)
LOG_REQUESTS=true

# Webhook Endpoints & Authentication Configuration
# JSON array containing one or more webhook destination targets.
# Each entry exposes an endpoint: POST /webhook/<id>
#
# Fields per webhook:
#   - id: Unique URL-safe identifier (a-z, 0-9, hyphen, underscore). Example: "production" -> /webhook/production
#   - secret: Shared secret key for authentication. Coolify must send: "Authorization: Bearer <secret>"
#   - baleBotToken: Bale Bot token obtained from @BotFather on Bale Messenger
#   - baleChatId: Target user ID, group ID, or channel ID where messages should be sent
WEBHOOKS=[{"id":"production","secret":"CHANGE_ME","baleBotToken":"YOUR_BALE_BOT_TOKEN","baleChatId":"YOUR_BALE_CHAT_ID"}]

# Message Formatting Options
# Set to 'true' to append the raw JSON payload in a <pre><code> block (safely truncated to fit Bale limits)
INCLUDE_RAW_PAYLOAD=false

# Link Preview Suppression
# Set to 'true' to suppress webpage link previews (URL unfurling) in Bale chat
DISABLE_LINK_PREVIEWS=true

# Optional: Rate Limiting (in-memory)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Optional: Bale API Custom Settings
# BALE_API_BASE_URL=https://tapi.bale.ai
# BALE_REQUEST_TIMEOUT_MS=10000
